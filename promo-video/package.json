{
  "name": "promo-video",
  "version": "1.0.0",
  "description": "MyHKU — Less searching. More learning. A 48-second original launch film.",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/media": "4.0.538",
    "@remotion/transitions": "4.0.538",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --no-open",
    "preview": "node scripts/preview.mjs",
    "build": "remotion bundle",
    "render": "remotion render MyHKU-Launch out/myhku-launch-1080p.mp4 --codec=h264 --crf=17 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k --concurrency=4",
    "poster": "remotion still MyHKU-Poster out/myhku-poster.png --frame=160",
    "score": "node scripts/generate-score.mjs",
    "capture": "node scripts/capture-demo.mjs",
    "verify": "node scripts/verify-render.mjs",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
